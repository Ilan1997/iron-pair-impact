---
import { Picture } from 'astro:assets';
import { imgFormats } from '../lib/content';
import type { ImageMetadata } from 'astro';
import Placeholder from './Placeholder.astro';

interface Props {
  image?: ImageMetadata;
  imageAlt: string;
  draft: boolean;
  eyebrow: string;
  title: string;
  subtitle: string;
  greeting: string;
}
const { image, imageAlt, draft, eyebrow, title, subtitle, greeting } = Astro.props;
const hasMedia = Boolean(image) || draft;
---

<section class:list={['hero', { 'has-media': hasMedia }]} id="top" aria-labelledby="hero-title">
  <div class="container hero-content">
    <p class="hero-eyebrow reveal">{eyebrow}</p>
    <h1 id="hero-title" class="reveal" style="--delay:.08s">
      <span class="q" aria-hidden="true">״</span>{title}<span class="q" aria-hidden="true">״</span>
    </h1>
    <p class="hero-sub reveal" style="--delay:.16s">{subtitle}</p>
  </div>

  {
    hasMedia && (
      <div class="container hero-media reveal" style="--delay:.22s">
        {image ? (
          <Picture
            src={image}
            alt={imageAlt}
            widths={[640, 960, 1280, 1600, 2048]}
            sizes="(max-width: 1160px) calc(100vw - 32px), 1080px"
            formats={imgFormats}
            loading="eager"
            fetchpriority="high"
            class="hero-img"
          />
        ) : (
          <Placeholder label="תמונת שער ממפגש של צמד ברזל" ratio="16/9" tone="dark" />
        )}
      </div>
    )
  }
</section>

<div class="container greeting-wrap">
  <div class="greeting reveal">
    <p>{greeting}</p>
    <span class="greeting-sign">צוות צמד ברזל</span>
  </div>
</div>

<style>
  .hero {
    position: relative;
    color: #fff;
    background:
      radial-gradient(90% 70% at 90% 0%, rgb(115 130 87 / 0.32), transparent 60%),
      linear-gradient(180deg, var(--ink-deep), var(--ink));
    padding-top: clamp(104px, 13vw, 160px);
    padding-bottom: clamp(56px, 8vw, 96px);
    overflow: hidden;
  }
  /* כשיש תמונה: הרקע הכהה נגמר באמצע התמונה */
  .hero.has-media {
    padding-bottom: 0;
    background:
      radial-gradient(90% 70% at 90% 0%, rgb(115 130 87 / 0.32), transparent 60%),
      linear-gradient(180deg, var(--ink-deep), var(--ink)) top / 100% calc(100% - clamp(90px, 16vw, 240px)) no-repeat,
      var(--paper);
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--accent-on-dark);
    padding: 7px 16px;
    border: 1px solid rgb(194 207 156 / 0.4);
    border-radius: 999px;
  }
  h1 {
    margin-top: 22px;
    font-size: clamp(2.2rem, 4.8vw + 0.6rem, 4.4rem);
    line-height: 1.1;
    max-width: 19ch;
    letter-spacing: -0.02em;
  }
  .q { color: var(--accent-on-dark); }
  .hero-sub {
    margin-top: 20px;
    max-width: 46ch;
    font-size: clamp(1.1rem, 0.6vw + 1rem, 1.35rem);
    color: rgb(255 255 255 / 0.82);
  }

  .hero-media { margin-top: clamp(36px, 5vw, 60px); }
  .hero-media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: center 55%;
    border-radius: var(--radius);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.55);
  }
  @media (max-width: 640px) {
    .hero-media :global(img) { aspect-ratio: 4 / 3; }
  }

  .greeting-wrap { position: relative; margin-top: clamp(28px, 4vw, 48px); }
  .greeting {
    background: #fff;
    border-radius: var(--radius);
    box-shadow: inset -5px 0 0 var(--accent-brand), var(--shadow);
    padding: clamp(26px, 4vw, 48px) clamp(24px, 4.5vw, 56px);
    max-width: 820px;
  }
  .greeting p {
    font-size: clamp(1.2rem, 0.9vw + 1rem, 1.55rem);
    line-height: 1.6;
    font-weight: 600;
  }
  .greeting-sign {
    display: block;
    margin-top: 18px;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 600;
  }
  .greeting-sign::before { content: '— '; }
</style>

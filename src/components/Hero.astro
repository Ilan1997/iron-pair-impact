---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Placeholder from './Placeholder.astro';

interface Props {
  image?: ImageMetadata;
  imageAlt: string;
  draft: boolean;
  eyebrow: string;
  title: string;
  subtitle: string;
  greeting: string;
}
const { image, imageAlt, draft, eyebrow, title, subtitle, greeting } = Astro.props;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-media">
    {
      image ? (
        <Picture
          src={image}
          alt={imageAlt}
          widths={[640, 960, 1440, 1920, 2560]}
          sizes="100vw"
          formats={['avif', 'webp']}
          loading="eager"
          fetchpriority="high"
          class="hero-img"
        />
      ) : (
        draft && (
          <div class="hero-ph">
            <Placeholder label="תמונת שער ממפגש של צמד ברזל" ratio="16/9" tone="dark" />
          </div>
        )
      )
    }
    <div class="hero-shade" aria-hidden="true"></div>
  </div>

  <div class="container hero-content">
    <p class="hero-eyebrow reveal">{eyebrow}</p>
    <h1 id="hero-title" class="reveal" style="--delay:.08s">
      <span class="q" aria-hidden="true">״</span>{title}<span class="q" aria-hidden="true">״</span>
    </h1>
    <p class="hero-sub reveal" style="--delay:.16s">{subtitle}</p>
  </div>
</section>

<div class="container greeting-wrap">
  <div class="greeting reveal">
    <p>{greeting}</p>
    <span class="greeting-sign">צוות צמד ברזל</span>
  </div>
</div>

<style>
  .hero {
    position: relative;
    min-height: min(92svh, 860px);
    display: flex;
    align-items: flex-end;
    color: #fff;
    background: var(--ink);
    isolation: isolate;
    overflow: hidden;
  }
  .hero-media { position: absolute; inset: 0; z-index: -1; }
  .hero-media :global(.hero-img),
  .hero-media :global(picture) { width: 100%; height: 100%; }
  .hero-media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 35%; }

  .hero-ph {
    position: absolute;
    top: 84px;
    inset-inline-end: var(--gutter);
    width: min(320px, 60vw);
    opacity: 0.9;
  }
  @media (min-width: 900px) {
    .hero-ph { top: 50%; transform: translateY(-60%); width: min(420px, 32vw); }
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(17 28 38 / 0.55) 0%, rgb(17 28 38 / 0) 28%),
      linear-gradient(0deg, rgb(17 28 38 / 0.96) 0%, rgb(17 28 38 / 0.7) 38%, rgb(17 28 38 / 0.1) 75%),
      radial-gradient(120% 80% at 85% 10%, rgb(166 75 36 / 0.28), transparent 60%);
  }

  .hero-content {
    padding-top: 140px;
    padding-bottom: clamp(120px, 15vw, 170px);
  }
  .hero-eyebrow {
    display: inline-block;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--accent-on-dark);
    padding: 7px 16px;
    border: 1px solid rgb(232 165 127 / 0.45);
    border-radius: 999px;
    background: rgb(17 28 38 / 0.35);
    backdrop-filter: blur(6px);
  }
  h1 {
    margin-top: 22px;
    font-size: clamp(2.2rem, 5.2vw + 0.6rem, 4.6rem);
    line-height: 1.08;
    max-width: 17ch;
    letter-spacing: -0.02em;
  }
  .q { color: var(--accent-on-dark); }
  .hero-sub {
    margin-top: 22px;
    max-width: 44ch;
    font-size: clamp(1.1rem, 0.6vw + 1rem, 1.35rem);
    color: rgb(255 255 255 / 0.84);
  }

  .greeting-wrap { position: relative; margin-top: calc(clamp(70px, 9vw, 110px) * -1); z-index: 2; }
  .greeting {
    background: #fff;
    border-radius: var(--radius);
    box-shadow: inset -5px 0 0 var(--accent), var(--shadow);
    padding: clamp(26px, 4vw, 48px) clamp(24px, 4.5vw, 56px);
    max-width: 820px;
  }
  .greeting p {
    font-size: clamp(1.2rem, 0.9vw + 1rem, 1.55rem);
    line-height: 1.6;
    font-weight: 600;
  }
  .greeting-sign {
    display: block;
    margin-top: 18px;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 600;
  }
  .greeting-sign::before { content: '— '; }
</style>

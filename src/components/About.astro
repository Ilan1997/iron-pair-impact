---
interface Props { title: string; text: string }
const { title, text } = Astro.props;
---

<section class="about" aria-label={title}>
  <div class="container">
    <p class="reveal"><span class="eyebrow">{title}</span>{text}</p>
  </div>
</section>

<style>
  .about { padding-block: clamp(56px, 8vw, 96px); }
  p {
    max-width: 900px;
    font-size: clamp(1.35rem, 1.3vw + 1rem, 2rem);
    line-height: 1.5;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .eyebrow { display: flex; margin-bottom: 14px; font-size: 0.82rem; }
</style>

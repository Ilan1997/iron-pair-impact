---
interface Props { title: string; text: string }
const { title, text } = Astro.props;
---

<section class="about" aria-labelledby="about-title">
  <div class="container about-grid">
    <div class="reveal">
      <span class="eyebrow">המיזם</span>
      <h2 id="about-title">{title}</h2>
    </div>
    <p class="reveal" style="--delay:.1s">{text}</p>
  </div>
</section>

<style>
  .about { padding-block: clamp(64px, 9vw, 110px) 0; }
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: clamp(20px, 5vw, 80px);
    align-items: start;
  }
  h2 { font-size: clamp(1.7rem, 2.2vw + 0.8rem, 2.4rem); margin-top: 12px; }
  p { font-size: clamp(1.1rem, 0.5vw + 1rem, 1.3rem); color: #2c3944; line-height: 1.8; }
  @media (max-width: 760px) { .about-grid { grid-template-columns: 1fr; } }
</style>

---
import { formatHebrewDate } from '../lib/content';

interface Stat { prefix: string; value: number; suffix: string; label: string; verified: boolean }
interface Props {
  title: string;
  draft: boolean;
  updatedAt: string;
  final: boolean;
  items: Stat[];
}
const { title, draft, updatedAt, final, items } = Astro.props;
const fmt = new Intl.NumberFormat('he-IL');
const dateText = formatHebrewDate(updatedAt);
const statusText = final ? `סיכום חודש אוקטובר · נכון ל־${dateText}` : `עודכן ב־${dateText}`;
---

{
  items.length > 0 && (
    <section class="numbers section" id="numbers" aria-labelledby="numbers-title">
      <div class="container">
        <div class="head reveal">
          <span class="eyebrow">ההשפעה</span>
          <h2 id="numbers-title">{title}</h2>
          {updatedAt && (
            <p class:list={['as-of', { interim: !final }]}>
              <span class="dot" aria-hidden="true" />
              {statusText}
            </p>
          )}
        </div>

        <ul class="stats" role="list">
          {items.map((s, i) => (
            <li class="stat reveal" style={`--delay:${i * 0.1}s`}>
              {draft && !s.verified && <span class="todo-badge stat-badge">טרם אומת</span>}
              {s.prefix && <span class="stat-prefix">{s.prefix}</span>}
              <span class="stat-value">
                <span data-count={s.value}>{fmt.format(s.value)}</span>
                {s.suffix && <span class="stat-suffix">{s.suffix}</span>}
              </span>
              <span class="stat-label">{s.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .numbers {
    background: var(--ink);
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  .numbers::before {
    content: '';
    position: absolute;
    inset: auto -10% -40% auto;
    width: 70vw;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgb(115 130 87 / 0.28), transparent 62%);
    pointer-events: none;
  }
  .numbers .eyebrow { color: var(--accent-on-dark); }
  .head { margin-bottom: clamp(36px, 5vw, 60px); position: relative; }
  .head h2 { font-size: clamp(2rem, 3.6vw + 0.8rem, 3.25rem); margin-top: 14px; }
  .as-of {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    font-size: 0.95rem;
    font-weight: 600;
    color: rgb(255 255 255 / 0.75);
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent-on-dark); }

  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: clamp(14px, 2vw, 24px);
    position: relative;
  }
  .stat {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 3.5vw, 44px);
    border-radius: var(--radius);
    background: linear-gradient(160deg, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0.025));
    border: 1px solid rgb(255 255 255 / 0.1);
    min-height: 220px;
  }
  .stat::after {
    content: '';
    position: absolute;
    top: 0;
    inset-inline-start: clamp(28px, 3.5vw, 44px);
    width: 40px;
    height: 3px;
    border-radius: 0 0 3px 3px;
    background: var(--accent-brand);
  }
  @media (max-width: 640px) { .stat { min-height: 0; padding-top: 34px; } }
  .stat-badge { position: absolute; top: 16px; inset-inline-end: 16px; }
  .stat-prefix {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--accent-on-dark);
    margin-top: auto;
  }
  .stat:not(:has(.stat-prefix)) .stat-value { margin-top: auto; }
  .stat-value {
    font-size: clamp(3.4rem, 5.5vw + 1rem, 5.4rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    direction: ltr;
    unicode-bidi: isolate;
    text-align: right;
  }
  .stat-suffix { font-size: 0.5em; margin-inline-start: 4px; }
  .stat-label {
    margin-top: 14px;
    font-size: 1.12rem;
    font-weight: 600;
    color: rgb(255 255 255 / 0.88);
    line-height: 1.4;
  }
</style>

---
import { youtubeId, formatHebrewDate } from '../lib/content';

interface Item { type: 'youtube' | 'instagram' | 'facebook' | 'article'; url: string; title: string; outlet: string; date: string }
interface Props {
  title: string;
  subtitle: string;
  items: Item[];
  placeholders: Item[];
}
const { title, subtitle, items, placeholders } = Astro.props;
const linkOnly = process.env.TARGET === 'artifact';
const videos = items.filter((m) => m.type === 'youtube' && youtubeId(m.url));
const links = items.filter((m) => !videos.includes(m));
const platform: Record<string, string> = { instagram: 'אינסטגרם', facebook: 'פייסבוק', article: 'כתבה', youtube: 'יוטיוב' };
---

{
  (items.length > 0 || placeholders.length > 0) && (
    <section class="media section" id="media" aria-labelledby="media-title">
      <div class="container">
        <div class="section-head reveal">
          <span class="eyebrow">ברשתות ובתקשורת</span>
          <h2 id="media-title">{title}</h2>
          {subtitle && <p>{subtitle}</p>}
        </div>

        <ul class="media-grid" role="list">
          {videos.map((m, i) => {
            const id = m.type === 'youtube' ? youtubeId(m.url) : null;
            const meta = [m.outlet, formatHebrewDate(m.date)].filter(Boolean).join(' · ');
            return (
              <li class="card reveal" style={`--delay:${i * 0.08}s`}>
                {id && linkOnly ? (
                  <a class="yt yt--link" href={m.url} target="_blank" rel="noopener" aria-label={`צפייה ביוטיוב: ${m.title}`}>
                    <span class="play" aria-hidden="true">
                      <svg viewBox="0 0 68 48"><rect width="68" height="48" rx="14" /><path d="M27 15v18l16-9z" /></svg>
                    </span>
                    <span class="yt-hint">לצפייה ביוטיוב</span>
                  </a>
                ) : id ? (
                  <div class="yt" data-yt={id} data-title={m.title}>
                    <img
                      src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      width="480"
                      height="360"
                    />
                    <button type="button" class="play" aria-label={`ניגון הסרטון: ${m.title}`}>
                      <svg viewBox="0 0 68 48" aria-hidden="true">
                        <rect width="68" height="48" rx="14" />
                        <path d="M27 15v18l16-9z" />
                      </svg>
                    </button>
                  </div>
                ) : (
                  <a class="article-link" href={m.url} target="_blank" rel="noopener">
                    <span aria-hidden="true">↗</span>
                  </a>
                )}
                <div class="card-body">
                  {meta && <p class="meta">{meta}</p>}
                  <h3>
                    {m.type === 'article' ? (
                      <a href={m.url} target="_blank" rel="noopener">{m.title}<span class="sr-only"> (נפתח בחלון חדש)</span></a>
                    ) : (
                      m.title
                    )}
                  </h3>
                  {m.type === 'youtube' && (
                    <a class="ext" href={m.url} target="_blank" rel="noopener">לצפייה ביוטיוב<span class="sr-only"> (נפתח בחלון חדש)</span></a>
                  )}
                </div>
              </li>
            );
          })}
          {placeholders.map((m) => (
            <li class="card is-todo reveal">
              <div class="yt-ph">
                <svg viewBox="0 0 68 48" aria-hidden="true">
                  <rect width="68" height="48" rx="14" />
                  <path d="M27 15v18l16-9z" />
                </svg>
                <span class="todo-badge">להשלמה</span>
              </div>
              <div class="card-body">
                <h3>{m.title}</h3>
                <p class="meta">יש להדביק את קישור היוטיוב בקובץ content/media.yaml</p>
              </div>
            </li>
          ))}
        </ul>

        {links.length > 0 && (
          <ul class="links" role="list">
            {links.map((m, i) => (
              <li class="reveal" style={`--delay:${i * 0.08}s`}>
                <a class={`link-card link--${m.type}`} href={m.url} target="_blank" rel="noopener">
                  <span class="link-badge" aria-hidden="true">
                    {m.type === 'instagram' && (
                      <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" /></svg>
                    )}
                    {m.type === 'facebook' && (
                      <svg viewBox="0 0 24 24"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z" /></svg>
                    )}
                    {(m.type === 'article' || m.type === 'youtube') && (
                      <svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8" /></svg>
                    )}
                  </span>
                  <span class="link-text">
                    <span class="link-platform">{m.outlet || platform[m.type]}</span>
                    <span class="link-title">{m.title}</span>
                  </span>
                  <span class="link-arrow" aria-hidden="true">←</span>
                  <span class="sr-only"> (נפתח בחלון חדש)</span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

<script>
  // הטמעת יוטיוב נטענת רק בלחיצה – שומר על מהירות האתר
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = box.dataset.title ?? 'סרטון';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      box.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .media-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(16px, 2.4vw, 28px);
  }
  .card {
    background: #fff;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
  }
  .card.is-todo { background: transparent; box-shadow: none; border: 1.5px dashed #c9bfae; }
  .yt, .yt-ph, .article-link {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--ink);
    display: grid;
    place-items: center;
  }
  .yt img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .play {
    position: relative;
    border: 0;
    background: none;
    padding: 0;
    cursor: pointer;
    transition: transform 0.2s;
  }
  .play:hover { transform: scale(1.08); }
  .play svg, .yt-ph svg { width: 68px; height: 48px; }
  .play svg rect { fill: rgb(21 40 66 / 0.82); }
  .play svg path { fill: #fff; }
  .yt-ph { background: var(--paper-2); gap: 12px; align-content: center; }
  .yt-ph svg rect { fill: #c9bfae; }
  .yt-ph svg path { fill: var(--paper-2); }
  .article-link { color: var(--accent-on-dark); font-size: 2.4rem; text-decoration: none; }
  .card-body { padding: 22px 24px 26px; }
  .card-body h3 { font-size: 1.22rem; font-weight: 700; line-height: 1.35; }
  .card-body h3 a { text-decoration: none; }
  .card-body h3 a:hover { text-decoration: underline; }
  .meta { font-size: 0.88rem; color: var(--muted); margin-bottom: 8px; font-weight: 600; }
  .is-todo .meta { margin: 10px 0 0; }
  .ext {
    display: inline-block;
    margin-top: 12px;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--accent);
  }
  .links {
    list-style: none;
    margin: clamp(16px, 2.4vw, 28px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(12px, 2vw, 20px);
  }
  .link-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 22px;
    background: #fff;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .link-card:hover { transform: translateY(-2px); }
  .link-badge {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: var(--ink);
    color: #fff;
  }
  .link--instagram .link-badge { background: linear-gradient(135deg, #f9a03f, #d6249f 55%, #6a3fd2); }
  .link--facebook .link-badge { background: #1877f2; }
  .link-badge svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .link--facebook .link-badge svg { fill: currentColor; stroke: none; }
  .link-text { display: grid; gap: 2px; flex: 1; min-width: 0; }
  .link-platform { font-size: 0.85rem; color: var(--muted); font-weight: 600; }
  .link-title { font-weight: 700; font-size: 1.08rem; line-height: 1.35; }
  .link-arrow { font-size: 1.3rem; color: var(--accent); transition: transform 0.25s; }
  .link-card:hover .link-arrow { transform: translateX(-4px); }
  .media-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); }
  .yt--link {
    text-decoration: none;
    color: #fff;
    gap: 14px;
    align-content: center;
    background:
      radial-gradient(80% 90% at 85% 0%, rgb(115 130 87 / 0.45), transparent 60%),
      linear-gradient(160deg, var(--ink), var(--ink-deep));
  }
  .yt--link .play svg rect { fill: rgb(255 255 255 / 0.14); }
  .yt--link:hover .play { transform: scale(1.08); }
  .yt-hint { font-weight: 700; font-size: 0.95rem; color: var(--accent-on-dark); }
</style>

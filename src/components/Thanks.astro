---
import { Picture } from 'astro:assets';
import { imgFormats } from '../lib/content';
import type { ImageMetadata } from 'astro';
import Placeholder from './Placeholder.astro';

interface Props {
  title: string;
  paragraphs: string[];
  image?: ImageMetadata;
  imageAlt: string;
  draft: boolean;
}
const { title, paragraphs, image, imageAlt, draft } = Astro.props;
const hasMedia = Boolean(image) || draft;
---

<section class:list={['thanks', { 'no-media': !hasMedia }]} aria-labelledby="thanks-title">
  <div class="container grid">
    {
      hasMedia && (
        <div class="media reveal">
          {image ? (
            <Picture
              src={image}
              alt={imageAlt}
              widths={[600, 900, 1300]}
              sizes="(max-width: 860px) 100vw, 560px"
              formats={imgFormats}
              loading="lazy"
            />
          ) : (
            <Placeholder label="תמונה משמעותית לסיום" ratio="4/5" tone="dark" />
          )}
        </div>
      )
    }
    <div class="text reveal" style="--delay:.1s">
      <span class="eyebrow">תודה</span>
      <h2 id="thanks-title">{title}</h2>
      {paragraphs.map((p) => <p>{p}</p>)}
      <p class="sign">באהבה ובהערכה,<br /><strong>צוות צמד ברזל</strong></p>
    </div>
  </div>
</section>

<style>
  .thanks {
    background: var(--ink);
    color: #fff;
    padding-block: var(--section);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .no-media .grid { grid-template-columns: 1fr; max-width: 820px; text-align: center; }
  .no-media .eyebrow { justify-content: center; }
  .media :global(img) { width: 100%; height: auto; border-radius: var(--radius); }
  .eyebrow { color: var(--accent-on-dark); }
  h2 { font-size: clamp(2.1rem, 3.8vw + 0.8rem, 3.6rem); margin: 16px 0 26px; }
  .text p { font-size: clamp(1.1rem, 0.5vw + 1rem, 1.3rem); color: rgb(255 255 255 / 0.86); line-height: 1.8; }
  .text p + p { margin-top: 16px; }
  .text .sign { margin-top: 36px; font-size: 1rem; color: rgb(255 255 255 / 0.7); }
  .sign strong { color: #fff; font-size: 1.15rem; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } .media { max-width: 520px; } }
</style>

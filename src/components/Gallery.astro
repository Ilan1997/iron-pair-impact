---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Placeholder from './Placeholder.astro';

interface Photo { image: ImageMetadata; alt: string; caption: string }
interface Props {
  title: string;
  subtitle: string;
  photos: Photo[];
  placeholders: number;
}
const { title, subtitle, photos, placeholders } = Astro.props;

// גרסה גדולה לכל תמונה – לתצוגה בהגדלה
const large = await Promise.all(
  photos.map((p) => getImage({ src: p.image, width: Math.min(2200, p.image.width), format: 'webp', quality: 85 })),
);
const phRatios = ['4/5', '4/3', '1/1', '3/4', '16/10', '4/3', '5/4', '3/4'];
---

{
  (photos.length > 0 || placeholders > 0) && (
    <section class="gallery section" id="gallery" aria-labelledby="gallery-title">
      <div class="container">
        <div class="section-head reveal">
          <span class="eyebrow">אוקטובר בתמונות</span>
          <h2 id="gallery-title">{title}</h2>
          {subtitle && <p>{subtitle}</p>}
        </div>

        <ul class="masonry" role="list">
          {photos.map((p, i) => (
            <li class="tile reveal" style={`--delay:${(i % 3) * 0.06}s`}>
              <button
                type="button"
                class="tile-btn"
                data-lb-index={i}
                data-lb-src={large[i].src}
                data-lb-alt={p.alt}
                data-lb-caption={p.caption}
                aria-label={`הגדלת תמונה: ${p.alt}`}
              >
                <Picture
                  src={p.image}
                  alt={p.alt}
                  widths={[420, 720, 1080]}
                  sizes="(max-width: 560px) 100vw, (max-width: 980px) 50vw, 380px"
                  formats={['avif', 'webp']}
                  loading="lazy"
                  decoding="async"
                />
                <span class="zoom" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M10 4a6 6 0 1 0 0 12 6 6 0 0 0 0-12Zm10 16-5-5M10 7v6M7 10h6" /></svg>
                </span>
              </button>
            </li>
          ))}
          {Array.from({ length: placeholders }).map((_, i) => (
            <li class="tile reveal" style={`--delay:${(i % 3) * 0.06}s`}>
              <Placeholder ratio={phRatios[i % phRatios.length]} />
            </li>
          ))}
        </ul>
      </div>

      {photos.length > 0 && (
        <dialog class="lb" data-lightbox aria-label="תצוגת תמונה מוגדלת">
          <div class="lb-inner">
            <button type="button" class="lb-close" data-lb-close aria-label="סגירה">
              <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
            <figure class="lb-figure">
              <img data-lb-img alt="" />
              <figcaption data-lb-cap></figcaption>
            </figure>
            {photos.length > 1 && (
              <>
                <button type="button" class="lb-nav lb-prev" data-lb-prev aria-label="התמונה הקודמת">
                  <svg viewBox="0 0 24 24"><path d="m9 6 6 6-6 6" /></svg>
                </button>
                <button type="button" class="lb-nav lb-next" data-lb-next aria-label="התמונה הבאה">
                  <svg viewBox="0 0 24 24"><path d="m15 6-6 6 6 6" /></svg>
                </button>
              </>
            )}
            <p class="lb-count" data-lb-count aria-live="polite"></p>
          </div>
        </dialog>
      )}
    </section>
  )
}

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dlg) {
    const tiles = [...document.querySelectorAll<HTMLButtonElement>('[data-lb-index]')];
    const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const cap = dlg.querySelector<HTMLElement>('[data-lb-cap]')!;
    const count = dlg.querySelector<HTMLElement>('[data-lb-count]')!;
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      current = (i + tiles.length) % tiles.length;
      const t = tiles[current];
      img.src = t.dataset.lbSrc!;
      img.alt = t.dataset.lbAlt ?? '';
      cap.textContent = t.dataset.lbCaption ?? '';
      cap.hidden = !t.dataset.lbCaption;
      count.textContent = `${current + 1} מתוך ${tiles.length}`;
    };

    tiles.forEach((t, i) =>
      t.addEventListener('click', () => {
        opener = t;
        show(i);
        dlg.showModal();
        document.body.style.overflow = 'hidden';
      }),
    );
    dlg.addEventListener('close', () => {
      document.body.style.overflow = '';
      opener?.focus();
    });
    dlg.querySelector('[data-lb-close]')?.addEventListener('click', () => dlg.close());
    // בעברית: "הבא" הוא שמאלה
    dlg.querySelector('[data-lb-next]')?.addEventListener('click', () => show(current + 1));
    dlg.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(current - 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg || (e.target as HTMLElement).classList.contains('lb-inner')) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current + 1);
      if (e.key === 'ArrowRight') show(current - 1);
    });
    // החלקה בנייד
    let x0: number | null = null;
    dlg.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    dlg.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(current + (dx > 0 ? 1 : -1));
      x0 = null;
    });
  }
</script>

<style>
  .masonry {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3 300px;
    column-gap: clamp(12px, 1.6vw, 20px);
  }
  .tile { break-inside: avoid; margin-bottom: clamp(12px, 1.6vw, 20px); }
  .tile-btn {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--paper-2);
    border-radius: var(--radius);
    overflow: hidden;
    cursor: zoom-in;
  }
  .tile-btn :global(img) {
    width: 100%;
    height: auto;
    transition: transform 0.7s cubic-bezier(.2,.7,.2,1);
  }
  .tile-btn:hover :global(img) { transform: scale(1.025); }
  .zoom {
    position: absolute;
    bottom: 12px;
    inset-inline-start: 12px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgb(21 40 66 / 0.6);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .zoom svg { width: 18px; height: 18px; fill: none; stroke: #fff; stroke-width: 2; stroke-linecap: round; }
  .tile-btn:hover .zoom, .tile-btn:focus-visible .zoom { opacity: 1; }
  @media (hover: none) { .zoom { opacity: 1; } }

  /* ---------- הגדלה ---------- */
  .lb {
    width: 100vw; height: 100dvh; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0;
    background: rgb(10 16 22 / 0.96);
    color: #fff;
  }
  .lb::backdrop { background: rgb(10 16 22 / 0.9); }
  .lb-inner {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: 64px clamp(12px, 6vw, 96px) 56px;
  }
  .lb-figure { margin: 0; display: grid; justify-items: center; gap: 14px; max-height: 100%; }
  .lb-figure img {
    max-width: 100%;
    max-height: calc(100dvh - 160px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
  }
  .lb-figure figcaption { font-size: 1rem; color: rgb(255 255 255 / 0.85); text-align: center; max-width: 60ch; }
  .lb button {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px; height: 48px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.2);
    background: rgb(255 255 255 / 0.08);
    color: #fff;
    cursor: pointer;
  }
  .lb button:hover { background: rgb(255 255 255 / 0.18); }
  .lb button svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .lb-close { top: 12px; inset-inline-end: 12px; }
  .lb-prev { inset-inline-start: 12px; top: 50%; transform: translateY(-50%); }
  .lb-next { inset-inline-end: 12px; top: 50%; transform: translateY(-50%); }
  .lb-count { position: absolute; bottom: 16px; inset-inline: 0; text-align: center; font-size: 0.9rem; color: rgb(255 255 255 / 0.65); }
  @media (max-width: 600px) {
    .lb-nav { top: auto !important; bottom: 8px; transform: none !important; }
  }
</style>

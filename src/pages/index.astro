---
/**
 * דף הבית בכוונה אינו מציג רשימת תורמים ואינו מקשר לדפים האישיים.
 * כל תורם מקבל קישור ישיר לדף שלו.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import { getContent } from '../lib/content';
const c = getContent();
---

<BaseLayout title="צמד ברזל – דיווח לשותפים" description="דיווח אישי לשותפי צמד ברזל." allowIndex={false}>
  <main id="main" class="home">
    <Logo image={c.logos.ironPair} text="צמד ברזל" height={56} tone="light" />
    <h1>דיווח אישי לשותפי צמד ברזל</h1>
    <p>הדיווחים נשלחים לכל שותף בקישור אישי.</p>
  </main>
</BaseLayout>

<style>
  .home {
    min-height: 100svh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 18px;
    text-align: center;
    padding: 24px;
    background: var(--ink);
    color: #fff;
  }
  h1 { font-size: clamp(1.6rem, 3vw + 0.6rem, 2.4rem); margin-top: 12px; }
  p { color: rgb(255 255 255 / 0.72); }
</style>
